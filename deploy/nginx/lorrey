server {
    server_name dipaliassociatesco.com www.dipaliassociatesco.com new.dipaliassociatesco.com;

    root /var/www/lorrey;
    index index.html;

    # 1. High-speed caching for Vite build assets (JS, CSS, images)
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }

    # 2. Never cache index.html (guarantees new deployments show up instantly)
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-store, no-cache, must-revalidate";
    }

    # SSL configuration (managed by Certbot)
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/dipaliassociatesco.com/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/dipaliassociatesco.com/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

# Redirect all plain HTTP (port 80) traffic to secure HTTPS (port 443)
server {
    listen 80;
    server_name dipaliassociatesco.com www.dipaliassociatesco.com new.dipaliassociatesco.com;

    return 301 https://$host$request_uri;
}
